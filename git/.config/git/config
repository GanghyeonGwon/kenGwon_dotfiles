# 노트북·빌드서버 공통 git 설정 (dotfiles 로 관리)
#
# git 은 이 파일(~/.config/git/config)과 ~/.gitconfig 를 둘 다 읽는다. 같은 키는 ~/.gitconfig 가 이긴다.
#   - 여기: 머신과 상관없는 공통 설정(delta 등)
#   - ~/.gitconfig: 머신마다 다른 것(user.name/email, 인증, url 재작성 등). dotfiles 에 넣지 않는다.

# delta: git diff/log/show 를 구문 강조·줄 번호와 함께 보여 주는 pager (mise 로 설치)
# delta 가 PATH 에 없으면(오래된 프로세스, mise 미설치 머신) 예전처럼 less / 원본 출력으로 떨어진다.
[core]
	pager = command -v delta >/dev/null 2>&1 && exec delta || exec less
[interactive]
	# git add -p 등. --color-only 는 줄 수를 바꾸지 않아 git 이 입력 줄과 1:1 로 맞출 수 있다
	diffFilter = command -v delta >/dev/null 2>&1 && exec delta --color-only || exec cat
[delta]
	navigate = true                      # n / N 으로 파일·hunk 사이 이동
	# 어두운 터미널 전용으로 고정한다(두 머신 모두 dark, nvim 도 vscode dark).
	# syntax-theme 을 지정하면 delta 의 light/dark 자동 선택보다 이게 우선한다.
	dark = true
	line-numbers = true
	syntax-theme = Visual Studio Dark+   # nvim 컬러스킴(vscode)과 같은 계열
